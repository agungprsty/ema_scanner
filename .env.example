# ==============================================================================
# CRYPTO MACD SCANNER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=7860
# Host interface for the published app port in docker-compose.prod.yml (keep 127.0.0.1 behind nginx)
APP_BIND_ADDR=127.0.0.1
# Legacy flag, still accepted but unused: the app only publishes signals and never places orders,
# so /api/info always reports mode SIGNALS_ONLY with edge_validated false
DRY_RUN=true
# REQUIRED for owner endpoints: the journal (read and write), watchlist changes, scan, evaluate, cron trigger
# and the profitloss record. The signal ledger, performance, health and cron status stay public.
# Scripts send it as X-API-KEY (or Authorization: Bearer); the dashboard signs in once and holds a session cookie.
# If empty, a placeholder, or shorter than 16 characters, those endpoints are disabled and respond with HTTP 503.
# Rotating it signs out every dashboard session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
CORS_ORIGINS=*
# Dashboard session cookie (HttpOnly, SameSite=Strict, HMAC-signed). Keep COOKIE_SECURE=true behind HTTPS;
# set it to false only to sign in over plain http://localhost during development
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
# Public origin for absolute og:url / canonical links on shareable pages (/s/{id}); empty uses the request's
# Host header and scheme (plain http behind the proxy), and the app warns at boot. Set it in production:
# PUBLIC_BASE_URL=https://your_domain.com
PUBLIC_BASE_URL=
# Serve /docs, /redoc and /openapi.json (off by default)
ENABLE_API_DOCS=false

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=macd_scanner
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/macd_scanner

# Redis (Caching & Signal Deduplication)
# Used when running the app outside Docker; docker compose always points the app at its redis service
REDIS_URL=redis://redis:6379/0

# Binance API Credentials
# Not needed: the app only reads public market data (klines, exchange info, 24h tickers). Unless
# BINANCE_AUTH_ENABLED=true, the variables below are never read and the client is built without credentials.
# Leave them empty (and keep keys off the server) unless a future feature needs signed endpoints.
BINANCE_AUTH_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional RSA Key Authentication (only with BINANCE_AUTH_ENABLED=true)
BINANCE_PRIVATE_KEY=
BINANCE_PRIVATE_KEY_PATH=
BINANCE_PRIVATE_KEY_PASSPHRASE=

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Send a message when a tracked trade hits its target, its stop, or expires
TELEGRAM_OUTCOME_ALERTS=true
# Shadow strategies are stored, evaluated and shown but never alerted unless this is true
SHADOW_ALERTS=false

# MACD parameters of the ad-hoc POST /api/scan. The scheduled scan, the evaluator and the backtest
# use the frozen parameters of each registered strategy version (src/strategy/), not these
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MACD_TIMEFRAME=2h
MACD_CROSS_LOOKBACK_CANDLES=5
MACD_MAX_SYMBOLS=50
MACD_INCLUDE_CURRENT=false
# Candles fetched per symbol; MACD needs a long history to match charting platforms
MACD_CANDLES=500

# Trade tracking
RISK_REWARD_RATIO=1.5
SWING_LOOKBACK_CANDLES=5
# Close a signal as EXPIRED when neither target nor stop is hit within this many 2H candles (48 = 4 days)
SIGNAL_EXPIRY_CANDLES=48
# Exchange fees for opening plus closing a position, in percent (taker 0.05% x 2)
ROUND_TRIP_FEE_PERCENT=0.1

# The strategy version the headline statistics (/api/performance, summaries) report on, and the
# provenance stamped on ad-hoc scan signals. Scheduled signals carry their own registered version
STRATEGY_KEY=macd_cross
STRATEGY_VERSION=2.2.0

# Cost model used for gross/cost/net R of every booked trade. Entries and stop or expiry exits fill
# at market with adverse slippage; targets fill at the limit price with no slippage. Leave the three
# settings below unset to book under "cm1": one-way slippage BTCUSDT/ETHUSDT 2, SOLUSDT 8, XRPUSDT 10,
# ZECUSDT 20, NEARUSDT 25 and 10 bps for any other symbol, stops at 1.5x, plus ROUND_TRIP_FEE_PERCENT=0.1.
# Any override is published under a derived label "cmx-<hash>" (see /api/info), never as cm1.
# One-way slippage in basis points for symbols not listed in SLIPPAGE_BPS_MAP
#SLIPPAGE_BPS_DEFAULT=10
# JSON object of symbol to one-way slippage bps; when set it replaces the whole built-in map
#SLIPPAGE_BPS_MAP='{"BTCUSDT": 2, "ETHUSDT": 2, "SOLUSDT": 8, "XRPUSDT": 10, "ZECUSDT": 20, "NEARUSDT": 25}'
# Stop fills slip this many times the entry slippage, since stops trigger into the move
#STOP_SLIPPAGE_MULTIPLIER=1.5

# Scanner Settings
VOLUME_THRESHOLD_USD=50000000
SCAN_CONCURRENCY=10

# Automated Cron Scheduler (every 2 hours, just after each 2H candle closes)
CRON_ENABLED=true
CRON_SAFETY_DELAY_SECONDS=15
# Closed candles the scheduled scan re-checks, so crosses missed during a restart are caught up
CRON_LOOKBACK_CANDLES=3
# A scheduled signal found more than this many seconds after its entry candle opened (a catch-up
# after downtime, or a manual cron trigger mid-candle) is alerted as LATE and kept out of the stats
LATE_SIGNAL_GRACE_SECONDS=600
# /api/health reports "degraded" (cron_fresh false) once the last successful scheduled run is older than
# this many seconds; the default is one 2H slot plus 5 minutes. Every scheduled run is logged in cron_runs
CRON_STALE_SECONDS=7500
# Optional dead-man switch: an external monitor URL (e.g. https://hc-ping.com/<uuid>) requested with GET
# after every successful scheduled run; the monitor alerts when pings stop. Leave empty to disable
HEALTHCHECK_PING_URL=
# Production: set true so /api/health reports "degraded" whenever CRON_ENABLED is off, instead of healthy
REQUIRE_CRON=false
# Seconds each /api/health check (database, Redis, cron freshness) may take; a database that does not
# answer in time reads as down (503). Keep it below the Docker HEALTHCHECK timeout of 5s
HEALTH_PROBE_TIMEOUT_SECONDS=2

# Commit the image was built from, stamped on every detected event in the signal ledger. The CI build
# sets it (Docker build arg GIT_SHA); set it by hand only when running outside that image
# GIT_SHA=
