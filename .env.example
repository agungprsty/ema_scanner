# ==============================================================================
# SIMPLE-TRADE (CROSSLINE RSI SCANNER) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=7860
# Host interface for the published app port in docker-compose.prod.yml (keep 127.0.0.1 behind nginx)
APP_BIND_ADDR=127.0.0.1
DRY_RUN=true
# REQUIRED for mutating/protected endpoints (watchlist, journal, cron trigger).
# If empty, a placeholder, or shorter than 16 characters, those endpoints are disabled and respond with HTTP 503.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
CORS_ORIGINS=*

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simple-trade
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/simple-trade

# Redis (Caching & Scheduler Locks)
# Used when running the app outside Docker; docker compose always points the app at its redis service
REDIS_URL=redis://redis:6379/0

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Optional RSA Key Authentication
BINANCE_PRIVATE_KEY=
BINANCE_PRIVATE_KEY_PATH=.binance_api/binance_private.pem
BINANCE_PRIVATE_KEY_PASSPHRASE=

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Send a message when a tracked trade hits its target, its stop, expires, or is not filled
TELEGRAM_OUTCOME_ALERTS=true

# Candle timeframe: 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d (anything else stops the app at startup)
TIMEFRAME=1h

# RSI Strategy: LONG when RSI crosses down to <= RSI_OVERSOLD, SHORT when it crosses up to >= RSI_OVERBOUGHT.
# The limit entry sits at the signal candle's low (LONG) or high (SHORT).
RSI_PERIOD=14
RSI_OVERSOLD=28
RSI_OVERBOUGHT=72
# Take profit and stop loss, in percent from the limit entry
TP_PERCENT=2
SL_PERCENT=1
# Hours the limit may wait for a fill, and hours a filled trade is held before it closes as EXPIRED.
# Counted in candles of TIMEFRAME (rounded up), so they keep the same meaning when TIMEFRAME changes.
FILL_WINDOW_HOURS=12
MAX_HOLD_HOURS=24
# Exchange fees for opening plus closing a position, in percent (taker 0.05% x 2)
ROUND_TRIP_FEE_PERCENT=0.1

# Scanner Settings
# Candles fetched per symbol; Wilder RSI needs a long history to match charting platforms
SCAN_CANDLES=500
MAX_SYMBOLS=50
SCAN_CONCURRENCY=10

# Automated Cron Scheduler (runs just after each TIMEFRAME candle closes)
CRON_ENABLED=true
CRON_SAFETY_DELAY_SECONDS=15
# Closed candles the scheduled scan re-checks, so signals missed during a restart are caught up
CRON_LOOKBACK_CANDLES=3
