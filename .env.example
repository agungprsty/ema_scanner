# ==============================================================================
# CRYPTO MACD SCANNER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=7860
DRY_RUN=true
# REQUIRED for mutating/protected endpoints (watchlist, scan, evaluate, cron trigger, profitloss record).
# If empty, a placeholder, or shorter than 16 characters, those endpoints are disabled and respond with HTTP 503.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
CORS_ORIGINS=*

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=macd_scanner
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/macd_scanner

# Redis (Caching & Signal Deduplication)
REDIS_URL=redis://redis:6379/0

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Optional RSA Key Authentication
BINANCE_PRIVATE_KEY=
BINANCE_PRIVATE_KEY_PATH=.binance_api/binance_private.pem
BINANCE_PRIVATE_KEY_PASSPHRASE=
# Optional HTTP/HTTPS Proxy (e.g. http://user:pass@host:port)
BINANCE_PROXY=

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MACD Strategy Parameters (Strict 2H Timeframe)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MACD_TIMEFRAME=2h
MACD_CROSS_LOOKBACK_CANDLES=5
MACD_MAX_SYMBOLS=50
MACD_INCLUDE_CURRENT=false

# Scanner Settings
VOLUME_THRESHOLD_USD=50000000
SCAN_CONCURRENCY=10

# Automated Cron Scheduler (Jam 00, 02, 04, ...)
CRON_ENABLED=true
CRON_SAFETY_DELAY_SECONDS=15
